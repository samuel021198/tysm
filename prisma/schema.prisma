generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  USER
  ADMIN
}

/// Profile name pill. NORMAL draws nothing. An approved VerificationApplication sets this.
enum VerificationTier {
  NORMAL
  TRUSTED
  MERCHANT
}

enum ListingStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  UNLISTED
  ENDED
  SOLD
}

enum SaleType {
  BUY_NOW
  AUCTION
  BOTH
}

enum ConditionTrack {
  RAW
  GRADED
}

enum RawGrade {
  A
  B
  C
  D
}

enum Grader {
  PSA
  BGS
  CGC
  TAG
}

enum CardKind {
  TCG
  ATHLETE
  CELEBRITY
}

enum PhotoRole {
  FRONT
  BACK
  GALLERY
}

enum StockType {
  IN_STOCK
  PREORDER
}

enum CategoryLevel {
  ROOT
  GROUP
  LEAF
}

enum CatalogGame {
  POKEMON
  ONE_PIECE
  RIFTBOUND
  DEMO
  TOPPS_BASKETBALL
  TOPPS_SOCCER
}

enum PrintRegion {
  JP
  WEST
}

enum OrderStatus {
  PENDING_PAYMENT
  IN_ESCROW
  AWAITING_SHIP
  SHIPPED
  COMPLETED
  DISPUTED
  CANCELLED
  REFUNDED
}

enum OrderSource {
  BUY_NOW
  AUCTION
  OFFER
}

enum PaymentOutcome {
  NONE
  SUCCESS
  FAIL
  DISPUTE
}

enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// Buyer entry on a thread. Null until they choose. A price offer stays on the order.
enum ThreadIntent {
  INQUIRY
  DIRECT
}

enum DisputeStatus {
  OPEN
  BUYER_WINS
  SELLER_WINS
  APPEALED
  FINAL_BUYER
  FINAL_SELLER
}

enum ReportTarget {
  LISTING
  USER
  POST
  THREAD
}

enum ReportStatus {
  OPEN
  RESOLVED
}

model User {
  id                 String    @id @default(cuid())
  email              String?   @unique
  phone              String?   @unique
  phoneVerified      Boolean   @default(false)
  emailVerified      Boolean   @default(false)
  nickname           String
  /// Public @handle. Null until the member sets one. Changes are capped in UsernameChange.
  username           String?   @unique
  avatarUrl          String?
  bio                String?
  /// District or mall name shown on the public profile. Never a street or door number.
  handoverPlace      String?
  /// Up to 3 https URLs. A place name is stored as a Google Maps search link.
  profileLinks       String[]  @default([])
  /// Interest topics without a leading #. Not parsed from bio. At most 8.
  interestTags       String[]  @default([])
  role               UserRole  @default(USER)
  /// Badge beside the display name. NORMAL is quiet (no pill).
  verificationTier   VerificationTier @default(NORMAL)
  termsAcceptedAt    DateTime?
  /// Private-handover checkbox on 提出要約. Not the signup terms tick.
  p2pRiskAckAt       DateTime?
  bidBanned          Boolean   @default(false)
  consecutiveUnpaid  Int       @default(0)
  payoutMethod       String?
  payoutAccount      String?
  payoutHolder       String?
  storeName          String?
  storeDistrict      String?
  storeLine1         String?
  storeHours         String?
  notifyBids         Boolean   @default(true)
  notifyOffers       Boolean   @default(true)
  notifyOrders       Boolean   @default(true)
  notifyMessages     Boolean   @default(true)
  /// Opt-in. Category toggles still apply; this only queues the email channel.
  notifyEmail        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  addresses       Address[]
  listings        Listing[]
  ordersBought    Order[]         @relation("BuyerOrders")
  ordersSold      Order[]         @relation("SellerOrders")
  reviewsWritten  Review[]        @relation("ReviewsWritten")
  reviewsReceived Review[]        @relation("ReviewsReceived")
  ratingsWritten  DealRating[]    @relation("RatingsWritten")
  ratingsReceived DealRating[]    @relation("RatingsReceived")
  messages        Message[]
  cartItems       CartItem[]
  favorites       Favorite[]
  followers       Follow[]        @relation("SellerFollows")
  following       Follow[]        @relation("UserFollows")
  blocksMade      Block[]         @relation("BlocksMade")
  blocksReceived  Block[]         @relation("BlocksReceived")
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  proxyBids       ProxyBid[]
  bidEvents       BidEvent[]
  offers          Offer[]         @relation("BuyerOffers")
  threadsBuyer    MessageThread[] @relation("ThreadBuyer")
  threadsSeller   MessageThread[] @relation("ThreadSeller")
  reports         Report[]
  searches        SearchHistory[]
  views           ViewHistory[]
  outbound        OutboundStub[]
  collection      CollectionItem[]
  posts           Post[]
  postLikes       PostLike[]
  postSaves       PostSave[]
  postComments    PostComment[]
  stories         Story[]
  storyViews      StoryView[]
  feedHides       FeedHide[]
  usernameChanges UsernameChange[]
  verificationApplications VerificationApplication[]
}

/// One row per successful @username change. The edit form allows 2 in 30 days.
model UsernameChange {
  id        String   @id @default(cuid())
  userId    String
  username  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum VerificationTrack {
  TRUSTED
  MERCHANT
}

enum VerificationApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Seller verification request. One PENDING row per user is a partial unique index in the migration.
model VerificationApplication {
  id          String                        @id @default(cuid())
  userId      String
  track       VerificationTrack
  /// Object ref `private:verification/…` in R2_PRIVATE_BUCKET. Not a public URL.
  documentUrl String
  reason      String
  status      VerificationApplicationStatus @default(PENDING)
  createdAt   DateTime                      @default(now())
  decidedAt   DateTime?
  user        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}

model OtpChallenge {
  id        String   @id @default(cuid())
  target    String
  channel   String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([target, createdAt])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  recipient String
  phone     String
  line1     String
  district  String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id       String        @id @default(cuid())
  parentId String?
  slug     String        @unique
  nameZh   String
  nameEn   String
  level    CategoryLevel
  groupKey String?
  sort     Int           @default(0)
  parent   Category?     @relation("CatTree", fields: [parentId], references: [id])
  children Category[]    @relation("CatTree")
  listings Listing[]

  @@index([parentId])
}

/// Official printing. Images live on R2 or a remote source URL, never as bytes in Postgres.
model CatalogSet {
  id          String       @id @default(cuid())
  externalId  String       @unique
  game        CatalogGame  @default(POKEMON)
  printRegion PrintRegion
  code        String
  nameEn      String
  nameJa      String
  series      String?
  releaseDate String?
  total       Int?
  logoUrl     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  cards       CatalogCard[]

  @@index([printRegion, releaseDate])
  @@index([code])
  @@index([game, printRegion])
}

model CatalogCard {
  id              String       @id @default(cuid())
  externalId      String       @unique
  setId           String
  game            CatalogGame  @default(POKEMON)
  printRegion     PrintRegion
  collectorNumber String
  /// Digits of the collector number without leading zeros, for 020 / 20 search.
  numberKey       String       @default("")
  nameEn          String
  nameJa          String
  imageUrl        String
  sourceImageUrl  String?
  rarity          String?
  artist          String?
  /// Finish kept for search (Holo, Reverse Foil). Display titles use rarity, not this.
  finish          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  set             CatalogSet       @relation(fields: [setId], references: [id], onDelete: Cascade)
  listings        Listing[]
  listingItems    ListingItem[]
  collectionItems CollectionItem[]

  @@index([nameEn])
  @@index([nameJa])
  @@index([collectorNumber])
  @@index([numberKey])
  @@index([printRegion, numberKey])
  @@index([setId])
  @@index([game, printRegion])
}

model Listing {
  id                String         @id @default(cuid())
  sellerId          String
  categoryId        String
  status            ListingStatus  @default(DRAFT)
  saleType          SaleType
  title             String
  description       String         @default("")
  quantity          Int            @default(1)
  quantityAvailable Int            @default(1)
  /// Retired prepaid amounts. Platform shipping is HK$0; columns stay so old rows still load.
  shippingFee       Int            @default(0)
  shippingDays      Int            @default(3)
  shipLockerFee     Int            @default(0)
  shipMeetFee       Int            @default(0)
  shipSfCod         Boolean        @default(false)
  shipMeetup        Boolean        @default(false)
  shipPickup        Boolean        @default(false)
  meetupDistrict    String?
  meetupWindow      String?
  meetupNotes       String?
  price             Int?
  offersEnabled     Boolean        @default(false)
  minOffer          Int?
  startPrice        Int?
  auctionEndsAt     DateTime?
  currentBid        Int?
  leaderId          String?
  bidVersion        Int            @default(0)
  bidsVoided        Boolean        @default(false)
  auctionSettled    Boolean        @default(false)
  binLockOrderId    String?        @unique
  cardKind          CardKind
  cardNumber        String?
  rarity            String?
  game              String?
  setName           String?
  cardName          String?
  language          String?
  personName        String?
  seasonYear        String?
  brandSeries       String?
  conditionTrack    ConditionTrack
  rawGrade          RawGrade?
  grader            Grader?
  gradeValue        Int?
  certNumber        String?
  videoUrl          String?
  /// Off-market until this instant when status is SCHEDULED. Asia/Hong_Kong wall time is stored as UTC.
  /// Browse and feed only read ACTIVE. sweep() on page load and /api/cron/sweep flips due rows to ACTIVE.
  publishAt         DateTime?
  publishedAt       DateTime?
  stockType         StockType      @default(IN_STOCK)
  /// 3, 7, or 30 when stockType is IN_STOCK. Null on older rows and on preorders; shippingDays stays the order clock.
  shipWithinDays    Int?
  /// HK midnight of the seller's ship date when stockType is PREORDER.
  preorderShipDate  DateTime?
  viewCount         Int            @default(0)
  favoriteCount     Int            @default(0)
  catalogCardId     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  seller      User          @relation(fields: [sellerId], references: [id])
  category    Category      @relation(fields: [categoryId], references: [id])
  catalogCard CatalogCard?  @relation(fields: [catalogCardId], references: [id], onDelete: SetNull)
  photos    ListingPhoto[]
  items     ListingItem[]
  proxyBids ProxyBid[]
  bidEvents BidEvent[]
  offers    Offer[]
  cartItems CartItem[]
  favorites Favorite[]
  orderItems OrderItem[]
  threads        MessageThread[]
  views          ViewHistory[]
  collectionItem CollectionItem?

  @@index([status, publishedAt])
  @@index([sellerId])
  @@index([categoryId])
  @@index([auctionEndsAt])
  @@index([catalogCardId])
}

/// One card inside a listing. The buyer-facing title stays on Listing.title.
/// The first row is mirrored onto Listing card fields so older search and comps keep working.
model ListingItem {
  id              String         @id @default(cuid())
  listingId       String
  position        Int
  price           Int?
  cardName        String?
  catalogCardId   String?
  /// Catalog display line, e.g. 2023 Pokemon SV2a JP #193 Mew ex Super Rare. Empty when the seller typed the fields.
  catalogTitle    String?
  year            String?
  setName         String?
  setCode         String?
  collectorNumber String?
  rarity          String?
  language        String?
  game            String?
  conditionTrack  ConditionTrack @default(RAW)
  rawGrade        RawGrade?
  grader          Grader?
  gradeValue      Int?
  certNumber      String?
  listing         Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  catalogCard     CatalogCard?   @relation(fields: [catalogCardId], references: [id], onDelete: SetNull)

  @@index([listingId, position])
  @@index([catalogCardId])
}

model ListingPhoto {
  id        String    @id @default(cuid())
  listingId String
  url       String
  position  Int
  role      PhotoRole @default(GALLERY)
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model ProxyBid {
  id        String   @id @default(cuid())
  listingId String
  bidderId  String
  maxAmount Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidder    User     @relation(fields: [bidderId], references: [id])

  @@unique([listingId, bidderId])
}

model BidEvent {
  id           String   @id @default(cuid())
  listingId    String
  bidderId     String
  publicAmount Int
  createdAt    DateTime @default(now())
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidder       User     @relation(fields: [bidderId], references: [id])

  @@index([listingId, createdAt])
}

model Offer {
  id            String      @id @default(cuid())
  listingId     String
  buyerId       String
  status        OfferStatus
  round         Int         @default(1)
  amount        Int
  counterAmount Int?
  expiresAt     DateTime
  orderId       String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  listing       Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer         User        @relation("BuyerOffers", fields: [buyerId], references: [id])
  order         Order?      @relation(fields: [orderId], references: [id])

  @@index([listingId, status])
  @@index([buyerId])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  listingId String
  quantity  Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Order {
  id                 String          @id @default(cuid())
  buyerId            String
  sellerId           String
  status             OrderStatus
  source             OrderSource
  subtotal           Int
  shippingTotal      Int
  total              Int
  commissionBps      Int
  commissionAmount   Int
  sellerProceeds     Int
  paymentOutcome     PaymentOutcome  @default(NONE)
  shipDays           Int
  shippingMethod     String?
  /// Snapshot of the method the buyer picked: meetup district/notes, shop address, or COD.
  fulfillment        Json?
  courierName        String?
  trackingNumber     String?
  paymentBrand       String?
  payBy              DateTime?
  paidAt             DateTime?
  shipBy             DateTime?
  shippedAt          DateTime?
  autoReleaseAt      DateTime?
  escrowReleasedAt   DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?
  cancelReason       String?
  addressSnapshot    Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  buyer    User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller   User        @relation("SellerOrders", fields: [sellerId], references: [id])
  items    OrderItem[]
  dispute  Dispute?
  offer    Offer?
  reviews  Review[]
  ratings  DealRating[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, payBy])
  @@index([status, autoReleaseAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  listingId       String
  title           String
  unitPrice       Int
  quantity        Int
  shippingFee     Int
  imageUrl        String?
  conditionLabel  String?
  cardName        String?
  personName      String?
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing         Listing @relation(fields: [listingId], references: [id])

  @@index([orderId])
  @@index([listingId])
  @@index([cardName])
  @@index([personName])
}

model Dispute {
  id                String        @id @default(cuid())
  orderId           String        @unique
  openerId          String
  reason            String
  status            DisputeStatus @default(OPEN)
  decisionNote      String?
  appealReason      String?
  appealById        String?
  returnShippingDue Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model MessageThread {
  id        String        @id @default(cuid())
  listingId String?
  buyerId   String
  sellerId  String
  /// 查詢 or 直接購買. Null means the buyer has not chosen. 議價 is an order offer, not this column.
  intent    ThreadIntent?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  listing   Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyer     User      @relation("ThreadBuyer", fields: [buyerId], references: [id])
  seller    User      @relation("ThreadSeller", fields: [sellerId], references: [id])
  messages  Message[]

  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  imageUrl  String?
  readAt    DateTime?
  createdAt DateTime      @default(now())
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User          @relation(fields: [senderId], references: [id])

  @@index([threadId, createdAt])
}

model Review {
  id        String    @id @default(cuid())
  orderId   String
  authorId  String
  subjectId String
  stars     Int
  comment   String
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author    User      @relation("ReviewsWritten", fields: [authorId], references: [id])
  subject   User      @relation("ReviewsReceived", fields: [subjectId], references: [id])

  @@unique([orderId, authorId])
  @@index([subjectId])
}

/// One score per party after the handover is COMPLETED. No edits.
model DealRating {
  id        String   @id @default(cuid())
  orderId   String
  authorId  String
  subjectId String
  stars     Int
  /// Optional one line. Blank when the rater sends stars only.
  comment   String   @default("")
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author    User     @relation("RatingsWritten", fields: [authorId], references: [id], onDelete: Cascade)
  subject   User     @relation("RatingsReceived", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([orderId, authorId])
  @@index([subjectId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  sellerId   String
  createdAt  DateTime @default(now())
  follower   User     @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  seller     User     @relation("SellerFollows", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([followerId, sellerId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetType ReportTarget
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  reporter   User         @relation(fields: [reporterId], references: [id])

  @@index([status, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Browser Web Push subscription. Absent keys skip send; a 404/410 drops the row.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ViewHistory {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model SiteSetting {
  key   String @id
  value String
}

model OutboundStub {
  id        String   @id @default(cuid())
  channel   String
  userId    String
  payload   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum CollectionVisibility {
  PUBLIC
  PRIVATE
}

/// One physical card. Collect-only until `listingId` is set; that listing is the sale, not a second copy.
model CollectionItem {
  id             String               @id @default(cuid())
  ownerId        String
  listingId      String?              @unique
  visibility     CollectionVisibility @default(PUBLIC)
  title          String
  note           String               @default("")
  conditionTrack ConditionTrack
  rawGrade       RawGrade?
  grader         Grader?
  gradeValue     Int?
  cardName       String?
  catalogCardId  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listing     Listing?          @relation(fields: [listingId], references: [id], onDelete: SetNull)
  catalogCard CatalogCard?      @relation(fields: [catalogCardId], references: [id], onDelete: SetNull)
  photos      CollectionPhoto[]
  post        Post?

  @@index([ownerId, visibility])
  @@index([catalogCardId])
}

model CollectionPhoto {
  id       String         @id @default(cuid())
  itemId   String
  url      String
  position Int
  role     PhotoRole      @default(GALLERY)
  item     CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model Post {
  id               String   @id @default(cuid())
  authorId         String
  collectionItemId String?  @unique
  body             String   @default("")
  /// Topic labels without the leading #. Search uses exact match.
  tags             String[] @default([])
  createdAt        DateTime @default(now())

  author         User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  collectionItem CollectionItem? @relation(fields: [collectionItemId], references: [id], onDelete: Cascade)
  photos         PostPhoto[]
  likes          PostLike[]
  saves          PostSave[]
  comments       PostComment[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model PostPhoto {
  id       String @id @default(cuid())
  postId   String
  url      String
  position Int
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

/// Wishlist save of a post. Not a like, and not a card in My Binder.
model PostSave {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  /// Photo or GIF. Null keeps a text-only comment.
  imageUrl  String?
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

/// One viewer's hide. The post or listing stays up for everyone else.
model FeedHide {
  id         String   @id @default(cuid())
  userId     String
  /// POST or LISTING.
  targetType String
  targetId   String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, targetType])
}

/// Photo story. Hidden once `expiresAt` passes (24h from create). `purgeExpiredStories` in sweep deletes those rows.
model Story {
  id        String   @id @default(cuid())
  authorId  String
  imageUrl  String
  createdAt DateTime @default(now())
  expiresAt DateTime
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views     StoryView[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  userId   String
  viewedAt DateTime @default(now())
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([userId])
}

enum NewsTag {
  RELEASE
  RESTOCK
  DATE
}

/// One card-news row. `tag` is the list chip (發售／重販／抽選). Goldin, or a body with 成交價, shows 成交.
model NewsItem {
  id         String    @id
  slug       String    @unique
  title      String
  source     String
  teaser     String    @default("")
  body       String    @default("")
  coverUrl   String?
  brandColor String    @default("#111111")
  linkUrl    String?
  tag        NewsTag   @default(RELEASE)
  eventAt    DateTime?
  /// 入庫標記。公開列表按 eventAt（冇就 createdAt）排，唔再用呢個欄置頂。
  hot        Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([hot, eventAt])
}

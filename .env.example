# Runtime Postgres connection. Neon on Vercel injects the pooled URL here.
# Locally this is a direct URL. No quotes.
# postgresql://tysm:tysm@127.0.0.1:5432/tysm?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/tysm?schema=public

# Direct (non-pooled) URL for Prisma migrations. schema directUrl.
# Neon Marketplace injects DATABASE_URL_UNPOOLED on the Vercel project.
# Locally set the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/tysm?schema=public

# First admin: matched on login and by the seed script. Comma-separated ok.
ADMIN_EMAIL=admin@tysm.hk
ADMIN_PHONE=+85260000000

# Public site origin, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs the session cookie. Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-string

# Protects POST /api/internal/reseed. Use a different long random string.
# Leave it unset locally if you only seed with `npm run db:seed`.
BOOTSTRAP_SECRET=replace-with-a-different-long-random-string

# Runtime Postgres connection. Neon on Vercel injects the pooled URL here.
# Locally this is a direct URL. No quotes.
# postgresql://tysm:tysm@127.0.0.1:5432/tysm?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/tysm?schema=public

# Direct (non-pooled) URL for Prisma migrations. schema directUrl.
# Neon Marketplace injects DATABASE_URL_UNPOOLED on the Vercel project.
# Locally set the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/tysm?schema=public

# Stored on the seeded admin (user_admin). Not the login identifier.
# Comma-separated ok. promoteAdmin still matches these on an existing session.
ADMIN_EMAIL=admin@tysm.hk
ADMIN_PHONE=+85260000000

# Password for the login handle `admin` (user_admin). Never commit a real value.
# Minimum 8 characters. Leave unset until admin login should work.
# When set, the bcrypt hash is written by `npm run db:seed`, a reseed,
# POST /api/internal/admin-password (Bearer BOOTSTRAP_SECRET), or the next `admin` login.
# The request body is ignored. A reseed with this unset recreates user_admin with no password,
# because reseed wipes users. It does not invent a password.
ADMIN_PASSWORD=

# Public site origin, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs the session cookie. Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-string

# Protects POST /api/internal/reseed, POST /api/internal/admin-password,
# POST /api/internal/ingest-dex, and /api/internal/verification.
# Leave it unset locally if you only seed with `npm run db:seed`.
BOOTSTRAP_SECRET=replace-with-a-different-long-random-string

# Dex catalogs are free and keyless: Pokémon from TCGdex, One Piece EN from OPTCG,
# One Piece JP from the official card list, Riftbound EN from RiftHunt bulk.
# No API key. Scrydex is unused unless prices are added later.

# Cloudflare R2 (S3-compatible) for catalog card images and user photo uploads. Optional.
# When any of these are missing, CatalogCard.imageUrl keeps the source HTTPS URL
# and listing/story/message/post/comment uploads stay data URLs. No other secrets are required.
# R2_PUBLIC_BASE_URL is the public bucket origin, no trailing slash, https only.
# R2_PRIVATE_BUCKET is a second bucket for HKID / business registration only.
# Do not enable r2.dev or a public custom domain on it. It must differ from R2_BUCKET.
# The access key needs read/write on both buckets. Verification uploads fail closed when this is unset.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PRIVATE_BUCKET=

# Optional Web Push. When these are empty, the inbox still works and 開啟瀏覽器通知 stays hidden.
# Generate a pair with `npx web-push generate-vapid-keys`. The public key is not a secret.
# Use the same public value for both variables. VAPID_SUBJECT is a mailto: contact.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tysm.hk

# Optional Tenor key for GIF search in the comment sheet.
# When unset, search is off and a pasted https GIF link (tenor.com, giphy.com, klipy.com) still attaches.
# https://developers.google.com/tenor/guides/quickstart
TENOR_API_KEY=
